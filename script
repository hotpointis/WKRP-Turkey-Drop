
<style>
  #wkrp-turkey-scene {
    position: fixed;
    inset: 0;
    z-index: 2147483646;
    overflow: hidden;
    pointer-events: none;
  }

  #wkrp-chopper {
    position: absolute;
    top: 55px;
    left: calc(100vw + 220px);
    white-space: nowrap;
    animation: wkrp-fly 7s linear forwards;
  }

  #wkrp-chopper .helicopter {
    display: inline-block;
    font-size: 72px;
    line-height: 1;
  }

  #wkrp-chopper .label {
    display: inline-block;
    vertical-align: middle;
    margin-left: -8px;
    padding: 5px 8px;
    background: #b51e23;
    color: white;
    font: bold 12px Arial, sans-serif;
    border-radius: 4px;
  }

  .wkrp-turkey {
    position: absolute;
    top: 110px;
    font-size: 38px;
    line-height: 1;
    animation: wkrp-drop 2.7s ease-in forwards;
  }

  .wkrp-splat {
    position: absolute;
    bottom: 12px;
    font-size: 38px;
    line-height: 1;
    transform-origin: bottom center;
    animation: wkrp-splat 0.8s ease-out forwards;
  }

  .wkrp-impact {
    position: absolute;
    bottom: 20px;
    font-size: 30px;
    line-height: 1;
    animation: wkrp-impact 0.5s ease-out forwards;
  }

  @keyframes wkrp-fly {
    to { left: -220px; }
  }

  @keyframes wkrp-drop {
    from {
      transform: translateY(0) rotate(-20deg);
    }
    to {
      transform: translateY(var(--wkrp-fall-distance)) rotate(320deg);
    }
  }

  @keyframes wkrp-splat {
    0% {
      transform: scale(1.2, 0.25);
      opacity: 1;
    }
    35% {
      transform: scale(1.35, 0.2);
      opacity: 1;
    }
    100% {
      transform: scale(1.35, 0.2);
      opacity: 0;
    }
  }

  @keyframes wkrp-impact {
    from { transform: scale(0.5); opacity: 1; }
    to { transform: scale(1.6); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #wkrp-turkey-scene { display: none; }
  }
</style>

<script>
(function () {
  function runTurkeyDrop() {
    if (document.getElementById('wkrp-turkey-scene')) return;

    var parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric'
    }).formatToParts(new Date());

    function datePart(type) {
      return Number(parts.find(function (part) {
        return part.type === type;
      }).value);
    }

    var year = datePart('year');
    var month = datePart('month');
    var day = datePart('day');

    // Thanksgiving is the fourth Thursday in November.
    var firstWeekday = new Date(Date.UTC(year, 10, 1)).getUTCDay();
    var thanksgivingDay = 1 + ((4 - firstWeekday + 7) % 7) + 21;

    // Run November 1 through Thanksgiving Day, inclusive.
    if (month !== 11 || day > thanksgivingDay) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var sessionKey = 'wkrp-turkey-drop-' + year + '-' + month + '-' + day;

    try {
      if (sessionStorage.getItem(sessionKey)) return;
      sessionStorage.setItem(sessionKey, 'shown');
    } catch (error) {
      // Continue if browser storage is unavailable.
    }

    var scene = document.createElement('div');
    scene.id = 'wkrp-turkey-scene';
    scene.setAttribute('aria-hidden', 'true');

    var chopper = document.createElement('div');
    chopper.id = 'wkrp-chopper';
    chopper.innerHTML =
      '<span class="helicopter">🚁</span>' +
      '<span class="label">WKRP NEWS</span>';

    scene.appendChild(chopper);
    document.body.appendChild(scene);

    function makeSplat(left) {
      var impact = document.createElement('span');
      impact.className = 'wkrp-impact';
      impact.textContent = '💥';
      impact.style.left = left;
      scene.appendChild(impact);

      var splat = document.createElement('span');
      splat.className = 'wkrp-splat';
      splat.textContent = '🦃';
      splat.style.left = left;
      scene.appendChild(splat);

      setTimeout(function () {
        impact.remove();
        splat.remove();
      }, 850);
    }

    var dropped = 0;

    // Begin dropping after the chopper enters the screen.
    var dropStart = setTimeout(function () {
      dropTurkey();
      dropInterval = setInterval(dropTurkey, 350);
    }, 1600);

    var dropInterval;

    function dropTurkey() {
      if (dropped >= 12) {
        clearInterval(dropInterval);
        return;
      }

      var chopperPosition = chopper.getBoundingClientRect();
      var scenePosition = scene.getBoundingClientRect();

      // Drop turkeys beneath the helicopter as it flies left.
      var leftPixels = chopperPosition.left - scenePosition.left +
        chopperPosition.width - 85;

      // Keep every turkey visible, including on narrow screens.
      leftPixels = Math.max(
        8,
        Math.min(scenePosition.width - 46, leftPixels)
      );

      var left = leftPixels + 'px';
      var turkey = document.createElement('span');
      turkey.className = 'wkrp-turkey';
      turkey.textContent = '🦃';
      turkey.style.left = left;
      turkey.style.setProperty(
        '--wkrp-fall-distance',
        Math.max(0, scenePosition.height - 160) + 'px'
      );

      scene.appendChild(turkey);

      turkey.addEventListener('animationend', function () {
        turkey.remove();
        makeSplat(left);
      }, { once: true });

      dropped++;
      if (dropped >= 12) clearInterval(dropInterval);
    }

    setTimeout(function () {
      clearTimeout(dropStart);
      clearInterval(dropInterval);
      scene.remove();
    }, 10000);
  }

  if (document.readyState === 'complete') {
    runTurkeyDrop();
  } else {
    window.addEventListener('load', runTurkeyDrop, { once: true });
  }
})();
</script>
